SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

IMAGE_MAX_WIDTH_PX=8192
IMAGE_MAX_HEIGHT_PX=8192
IMAGE_MAX_PIXELS=16000000

# Enable Storage with the separate Compose overlay.
SUPABASE_STORAGE_BUCKET=personalization-originals
DOWNLOAD_URL_TTL_SECONDS=60

# Dedicated image worker (bounded batches and polling).
WORKER_BATCH_SIZE=10
WORKER_POLL_SECONDS=10

# Optional MIN_PRINT_DPI: integer 1..2400, only after team decision.
# Omit it while the resolution threshold is pending.
MIN_PRINT_DPI=

# Worker liveness; the effective age also allows 3 polling intervals.
WORKER_HEARTBEAT_MAX_AGE_SECONDS=180
