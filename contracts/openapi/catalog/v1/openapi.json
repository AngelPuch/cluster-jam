              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description" : "RFC 9457 Problem Details."
          }
        },
        "security" : [ {
          "supabaseBearer" : [ ]
        } ],
        "summary" : "Edit, publish or retire a product using its current revision.",
        "tags" : [ "Admin catalog" ]
      }
    },
