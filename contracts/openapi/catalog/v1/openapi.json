  "components" : {
    "responses" : {
      "CatalogConflict" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description" : "Duplicate SKU or combination, or invalid state transition."
      },
      "CatalogMissingRevision" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description" : "A current strong ETag is required in If-Match."
      },
      "CatalogStaleRevision" : {
        "content" : {
          "application/problem+json" : {
            "schema" : {
              "$ref" : "#/components/schemas/ProblemDetails"
            }
          }
        },
        "description" : "The validator does not match the current revision."
      }
    },
    "schemas" : {
      "CreateProduct" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "description" : {
            "type" : [ "string", "null" ],
            "maxLength" : 2000,
            "minLength" : 0,
            "pattern" : "[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F-\\x9F]*"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0,
            "pattern" : "[^\\x00-\\x1F\\x7F-\\x9F]+"
          },
          "typeId" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0,
            "maximum" : 32767
          }
        },
        "required" : [ "name", "typeId" ]
      },
      "CreateVariant" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "basePriceCents" : {
            "type" : "integer",
            "format" : "int64",
            "exclusiveMinimum" : 0,
            "maximum" : 10000000
          },
          "colorId" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0,
            "maximum" : 32767
          },
          "sizeId" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0,
            "maximum" : 32767
          },
          "sku" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "^[A-Z0-9][A-Z0-9_.-]{0,59}$"
          }
        },
        "required" : [ "basePriceCents", "colorId", "sizeId", "sku" ]
      },
      "EditProduct" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "description" : {
            "type" : [ "string", "null" ],
            "maxLength" : 2000,
            "minLength" : 0,
            "pattern" : "[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F-\\x9F]*"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 120,
            "minLength" : 0,
            "pattern" : "[^\\x00-\\x1F\\x7F-\\x9F]+"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "RETIRED" ]
          },
          "typeId" : {
            "type" : "integer",
            "format" : "int32",
            "exclusiveMinimum" : 0,
            "maximum" : 32767
          }
        },
        "required" : [ "name", "status", "typeId" ]
      },
      "EditVariant" : {
        "type" : "object",
        "additionalProperties" : false,
        "properties" : {
          "basePriceCents" : {
            "type" : "integer",
            "format" : "int64",
            "exclusiveMinimum" : 0,
            "maximum" : 10000000
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "RETIRED" ]
          }
        },
        "required" : [ "basePriceCents", "status" ]
      },
      "HealthResponse" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string",
            "enum" : [ "ok" ],
            "example" : "ok"
          }
        },
        "required" : [ "status" ]
      },
      "PageViewProductView" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProductView"
            }
          },
          "nextCursor" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          }
        }
      },
      "PageViewVariantView" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/VariantView"
            }
          },
          "nextCursor" : {
            "type" : [ "string", "null" ],
            "format" : "uuid"
          }
        }
      },
      "ProblemDetails" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "example" : "SERVICE_UNAVAILABLE"
          },
          "detail" : {
            "type" : "string",
            "example" : "The service is temporarily unavailable."
          },
          "errors" : {
            "type" : "array",
            "description" : "Controlled validation messages when applicable.",
            "items" : {
              "type" : "string"
            }
          },
          "instance" : {
            "type" : "string",
            "example" : "/health/ready"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32",
            "example" : 503
          },
          "title" : {
            "type" : "string",
            "example" : "Service Unavailable"
          },
          "traceId" : {
            "type" : "string",
            "example" : "4bf92f3577b34da6a3ce929d0e0e4736",
            "pattern" : "^[0-9a-f]{32}$"
          },
          "type" : {
            "type" : "string",
            "example" : "about:blank"
          }
        },
        "required" : [ "code", "detail", "instance", "status", "title", "traceId", "type" ]
      },
      "ProductView" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : [ "string", "null" ]
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "RETIRED" ]
          },
          "typeId" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      },
      "VariantView" : {
        "type" : "object",
        "properties" : {
          "basePriceCents" : {
            "type" : "integer",
            "format" : "int64"
          },
          "colorId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "currency" : {
            "type" : "string",
            "enum" : [ "MXN" ]
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "sizeId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "sku" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "DRAFT", "PUBLISHED", "RETIRED" ]
          }
        }
      }
    },
    "securitySchemes" : {
      "serviceBearer" : {
        "bearerFormat" : "JWT",
        "description" : "Service token with catalog-service audience.",
        "scheme" : "bearer",
        "type" : "http"
      },
      "supabaseBearer" : {
        "bearerFormat" : "JWT",
        "description" : "Supabase access token.",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
