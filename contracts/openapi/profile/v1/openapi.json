            "description": "Nonblank name; surrounding whitespace is removed. Null is not accepted.",
            "example": "María López",
            "maxLength": 120,
            "type": "string"
          },
          "phone": {
            "description": "7–15 digits with optional leading + and spaces, parentheses, dots or hyphens. Null is not accepted.",
