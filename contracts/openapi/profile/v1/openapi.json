            "example": "+52 55 1234 5678",
            "maxLength": 30,
            "nullable": true,
            "type": "string"
          },
          "updatedAt": {
            "example": "2026-10-29T18:05:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "userId": {
            "example": "11111111-1111-4111-8111-111111111111",
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "fullName",
          "phone",
          "contactEmail",
          "onboardingStatus",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "UpdateProfileDto": {
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "contactEmail": {
            "description": "Business contact address, independent from the Supabase login email. Null is not accepted.",
            "example": "contact@example.com",
            "format": "email",
            "maxLength": 254,
            "type": "string"
          },
