      },
      "ProfileResponseDto": {
        "properties": {
          "contactEmail": {
            "description": "Null only for historical profiles predating contact email; new profiles have the registration contact email.",
            "example": "contact@example.com",
            "format": "email",
            "maxLength": 254,
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "example": "2026-10-29T18:00:00.000Z",
            "format": "date-time",
            "type": "string"
          },
          "fullName": {
            "example": "María López",
            "maxLength": 120,
            "nullable": true,
            "type": "string"
          },
          "onboardingStatus": {
            "enum": [
              "PENDING",
              "COMPLETED"
            ],
            "example": "COMPLETED",
            "type": "string"
          },
