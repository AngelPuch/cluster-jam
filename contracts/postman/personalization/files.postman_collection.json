{
  "info": {
    "name": "Cluster JAM - Personalization Files",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Subir original",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/files",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.environment.set(\"fileId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar metadata",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/files/{{fileId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear enlace de descarga",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/files/{{fileId}}/download-urls"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"downloadUrl\", pm.response.json().downloadUrl);"
            ]
          }
        }
      ]
    },
    {
      "name": "Descargar original",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{downloadUrl}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Sin JWT",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/files",
        "auth": {
          "type": "noauth"
        },
        "description": "Send without Authorization and without a body. JWT validation must return 401 before multipart parsing; no local file is required."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Formato inválido",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/files",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "description": "Use the uploading client's token. Select an actual nonempty .txt file in Body > form-data > file (File). Never send an unselected file placeholder or a directory. Expected HTTP 415."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 415\", () => pm.response.to.have.status(415));"
            ]
          }
        }
      ]
    }
  ]
}
