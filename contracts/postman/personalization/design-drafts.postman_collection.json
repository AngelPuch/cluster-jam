      ]
    },
    {
      "name": "13 - Listar borradores propios y obtener cursor",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/design-drafts?limit=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "const value = pm.response.json();",
              "pm.test(\"Paginación de al menos dos borradores\", () => { pm.expect(value.items.length).to.eql(1); pm.expect(value.nextCursor).to.be.a(\"string\"); pm.expect(value.items[0].ownerId).to.eql(JSON.parse(pm.environment.get(\"draftSnapshot\")).ownerId); pm.expect(value.items[0]).not.to.have.property(\"applications\"); });",
              "pm.environment.set(\"draftNextCursor\", value.nextCursor); pm.environment.set(\"draftFirstPageId\", value.items[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Consultar siguiente página",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/design-drafts?limit=1&cursor={{draftNextCursor}}",
        "header": []
