    {
      "name": "18 - No permitir propietario en cuerpo",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/design-drafts",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"variantId\": \"{{draftVariantId}}\",\n  \"templateId\": \"{{draftTemplateId}}\",\n  \"applications\": [],\n  \"ownerId\": \"{{$guid}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"ProblemDetails VALIDATION_ERROR\", () => {",
