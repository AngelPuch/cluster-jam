{
  "info": {
    "name": "Cluster JAM - Print Catalog",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "21 pruebas en orden. Usa accessToken cliente y adminAccessToken administrador. Reutiliza printId anterior para seleccionar una imagen; crea un nuevo estampado QA y lo deja retirado al finalizar. No modifica el estampado original. Sin adjuntos. Variables automáticas catalog*. No exportar JWT ni URL firmadas."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Seleccionar imagen existente como administrador",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/prints/{{printId}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set(\"catalogSourceFileId\", pm.response.json().latestVersion.fileId);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear estampado exclusivo de QA",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/prints",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"QA catalog {{$guid}}\",\n  \"description\": \"Prueba de catálogo de estampados\",\n  \"fileId\": \"{{catalogSourceFileId}}\",\n  \"surchargeCents\": 1250\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.environment.set(\"catalogPrintId\", body.id);",
              "  pm.environment.set(\"catalogVersionId\", body.latestVersion.id);",
              "  pm.environment.set(\"catalogTestEtag\", pm.response.headers.get(\"ETag\"));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Cliente consulta catálogo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Contrato paginado sin originales\", () => {",
              "    pm.expect(Object.keys(body).sort()).to.eql([\"items\", \"nextCursor\"]);",
              "    for (const item of body.items) {",
              "      pm.expect(item.version.currency).to.eql(\"MXN\");",
              "      pm.expect(item.version.surchargeCents).to.be.a(\"number\");",
              "      pm.expect(item).not.to.have.property(\"ownerId\");",
              "      pm.expect(item.version).not.to.have.property(\"fileId\");",
              "      pm.expect(item.thumbnail.mimeType).to.eql(\"image/png\");",
              "    }",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Cliente consulta detalle y recargo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints/{{catalogPrintId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Versión y recargo aplicables\", () => {",
              "    pm.expect(body.id).to.eql(pm.environment.get(\"catalogPrintId\"));",
              "    pm.expect(body.version.id).to.eql(pm.environment.get(\"catalogVersionId\"));",
              "    pm.expect(body.version.surchargeCents).to.eql(1250);",
              "    pm.expect(body.version.currency).to.eql(\"MXN\");",
              "    pm.expect(body.thumbnail.widthPx).to.be.within(1, 320);",
              "    pm.expect(body.thumbnail.heightPx).to.be.within(1, 320);",
              "  });",
              "  pm.environment.set(\"catalogThumbnailId\", body.thumbnail.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Cliente crea enlace de miniatura",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/prints/{{catalogPrintId}}/versions/{{catalogVersionId}}/thumbnail/download-urls",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test(\"Solo se entrega la miniatura\", () => {",
              "    pm.expect(body.fileId).to.eql(pm.environment.get(\"catalogThumbnailId\"));",
              "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
              "  });",
              "  pm.environment.set(\"catalogDownloadUrl\", body.downloadUrl);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Descargar PNG antes de 60 segundos",
      "request": {
        "method": "GET",
        "url": "{{catalogDownloadUrl}}",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"PNG\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"image/png\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Administrador también consulta catálogo",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints/{{catalogPrintId}}",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Página de un elemento",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints?limit=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.test(\"Límite respetado\", () => pm.expect(pm.response.json().items.length).to.be.at.most(1)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Cursor final devuelve página vacía",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints?cursor=MTpwcmludC1jYXRhbG9nOmZmZmZmZmZmLWZmZmYtZmZmZi1mZmZmLWZmZmZmZmZmZmZmZg",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { pm.test(\"Fin del catálogo\", () => pm.expect(pm.response.json()).to.eql({items: [], nextCursor: null})); }"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Cursor inválido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints?cursor=invalid",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"INVALID_CURSOR\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Límite inválido",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints?limit=101",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"VALIDATION_ERROR\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Sin JWT",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints",
        "header": [],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"INVALID_ACCESS_TOKEN\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Estampado inexistente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints/{{$guid}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"PRINT_NOT_FOUND\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Versión incorrecta no entrega enlace",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/prints/{{catalogPrintId}}/versions/{{$guid}}/thumbnail/download-urls",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"PRINT_VERSION_NOT_FOUND\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Cliente no administra estampados",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/admin/prints/{{catalogPrintId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"FORBIDDEN\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - Administrador retira estampado de QA",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/v1/admin/prints/{{catalogPrintId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "If-Match",
            "value": "{{catalogTestEtag}}"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{adminAccessToken}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  pm.environment.set(\"catalogTestEtag\", pm.response.headers.get(\"ETag\"));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "17 - Retirado ya no es visible al cliente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/prints/{{catalogPrintId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"RFC 9457\", () => {",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  const body = pm.response.json();",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"PRINT_NOT_FOUND\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "18 - Retirado no genera enlaces nuevos",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/prints/{{catalogPrintId}}/versions/{{catalogVersionId}}/thumbnail/download-urls",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
