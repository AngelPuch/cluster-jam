    {
      "name": "07 - Primera página de versiones",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/template-versions?productId={{templateProductId}}&sizeId=1&limit=1",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const page = pm.response.json();",
              "  pm.test(\"Primera página\", () => {",
              "    pm.expect(page.items.length).to.eql(1);",
              "    pm.expect(page.items[0].number).to.eql(1);",
              "    pm.expect(page.nextCursor).to.be.a(\"string\");",
              "  });",
              "  pm.environment.set(\"templateNextCursor\", page.nextCursor);",
              "}"
            ]
          }
        }
      ]
    },
