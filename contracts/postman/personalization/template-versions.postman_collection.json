{
  "info": {
    "name": "Cluster JAM - Draft Template Versions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "25 pruebas en orden. Usa el entorno actual y JWT de administrador/cliente. ProductId técnico de QA se genera automáticamente; sizeId 1 no implica talla real. Todas las versiones quedan inactivas, sin validar Catalog ni publicar para clientes. No requiere imágenes ni servicios de Catalog. Repetir desde 01 genera otra serie QA."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Crear v1 en borrador con frente y espalda",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/template-versions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{$guid}}\",\n  \"sizeId\": 1,\n  \"expectedVersion\": 0,\n  \"front\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"back\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"zones\": [\n    {\n      \"code\": \"chest\",\n      \"side\": \"FRONT\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100.125\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        },\n        {\n          \"label\": \"MEDIUM\",\n          \"widthMm\": \"150\",\n          \"heightMm\": \"200\",\n          \"surchargeCents\": 2000\n        },\n        {\n          \"label\": \"LARGE\",\n          \"widthMm\": \"200\",\n          \"heightMm\": \"300\",\n          \"surchargeCents\": 3000\n        }\n      ]\n    },\n    {\n      \"code\": \"upper-back\",\n      \"side\": \"BACK\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100.125\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        },\n        {\n          \"label\": \"MEDIUM\",\n          \"widthMm\": \"150\",\n          \"heightMm\": \"200\",\n          \"surchargeCents\": 2000\n        },\n        {\n          \"label\": \"LARGE\",\n          \"widthMm\": \"200\",\n          \"heightMm\": \"300\",\n          \"surchargeCents\": 3000\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const value = pm.response.json();",
              "  pm.environment.set(\"templateProductId\", value.productId);",
              "  pm.environment.set(\"templateFirstId\", value.id);",
              "  pm.environment.set(\"templateV1Snapshot\", JSON.stringify(value));",
              "  pm.test(\"Borrador versionado\", () => {",
              "    pm.expect(value.number).to.eql(1);",
              "    pm.expect(value.active).to.eql(false);",
              "    pm.expect(value.zones.length).to.eql(2);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Consultar v1 y medidas en centímetros",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/template-versions/{{templateFirstId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const value = pm.response.json();",
              "  pm.test(\"Medidas exactas y tres tamaños\", () => {",
              "    pm.expect(value).to.eql(JSON.parse(pm.environment.get(\"templateV1Snapshot\")));",
              "    const sizes = value.zones[0].sizes;",
              "    pm.expect(sizes.map(item => item.label)).to.eql([\"SMALL\", \"MEDIUM\", \"LARGE\"]);",
              "    pm.expect(sizes[0].widthMm).to.eql(\"100.125\");",
              "    pm.expect(sizes[0].widthCm).to.eql(\"10.0125\");",
              "    pm.expect(sizes[0].currency).to.eql(\"MXN\");",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - ExpectedVersion anterior",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/template-versions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{templateProductId}}\",\n  \"sizeId\": 1,\n  \"expectedVersion\": 0,\n  \"front\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"back\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"zones\": [\n    {\n      \"code\": \"chest\",\n      \"side\": \"FRONT\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100.125\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        },\n        {\n          \"label\": \"MEDIUM\",\n          \"widthMm\": \"150\",\n          \"heightMm\": \"200\",\n          \"surchargeCents\": 2000\n        },\n        {\n          \"label\": \"LARGE\",\n          \"widthMm\": \"200\",\n          \"heightMm\": \"300\",\n          \"surchargeCents\": 3000\n        }\n      ]\n    },\n    {\n      \"code\": \"upper-back\",\n      \"side\": \"BACK\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100.125\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        },\n        {\n          \"label\": \"MEDIUM\",\n          \"widthMm\": \"150\",\n          \"heightMm\": \"200\",\n          \"surchargeCents\": 2000\n        },\n        {\n          \"label\": \"LARGE\",\n          \"widthMm\": \"200\",\n          \"heightMm\": \"300\",\n          \"surchargeCents\": 3000\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
              "pm.test(\"RFC 9457\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"TEMPLATE_VERSION_CONFLICT\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Crear v2 con geometría y recargo nuevos",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/template-versions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{templateProductId}}\",\n  \"sizeId\": 1,\n  \"expectedVersion\": 1,\n  \"front\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"back\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"zones\": [\n    {\n      \"code\": \"chest\",\n      \"side\": \"FRONT\",\n      \"xMm\": \"60\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100.125\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1300\n        },\n        {\n          \"label\": \"MEDIUM\",\n          \"widthMm\": \"150\",\n          \"heightMm\": \"200\",\n          \"surchargeCents\": 2000\n        },\n        {\n          \"label\": \"LARGE\",\n          \"widthMm\": \"200\",\n          \"heightMm\": \"300\",\n          \"surchargeCents\": 3000\n        }\n      ]\n    },\n    {\n      \"code\": \"upper-back\",\n      \"side\": \"BACK\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100.125\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        },\n        {\n          \"label\": \"MEDIUM\",\n          \"widthMm\": \"150\",\n          \"heightMm\": \"200\",\n          \"surchargeCents\": 2000\n        },\n        {\n          \"label\": \"LARGE\",\n          \"widthMm\": \"200\",\n          \"heightMm\": \"300\",\n          \"surchargeCents\": 3000\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const value = pm.response.json();",
              "  pm.environment.set(\"templateSecondId\", value.id);",
              "  pm.test(\"Nueva versión, nuevos IDs y sin publicar\", () => {",
              "    const previous = JSON.parse(pm.environment.get(\"templateV1Snapshot\"));",
              "    pm.expect(value.number).to.eql(2);",
              "    pm.expect(value.active).to.eql(false);",
              "    pm.expect(value.id).not.to.eql(previous.id);",
              "    pm.expect(value.zones[0].id).not.to.eql(previous.zones[0].id);",
              "    pm.expect(value.zones[0].sizes[0].id).not.to.eql(previous.zones[0].sizes[0].id);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
