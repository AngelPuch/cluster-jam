        "body": {
          "mode": "raw",
          "raw": "{\n  \"applications\": [\n    {\n      \"zoneId\": \"{{$guid}}\",\n      \"zoneSizeId\": \"{{analysisFrontSizeId}}\",\n      \"printVersionId\": \"{{analysisPrintVersionId}}\"\n    },\n    {\n      \"zoneId\": \"{{analysisBackZoneId}}\",\n      \"zoneSizeId\": \"{{analysisBackSizeId}}\",\n      \"fileId\": \"{{analysisFileId}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"RFC 9457\", () => {",
              "  const body = pm.response.json();",
              "  pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
              "  pm.expect(Object.keys(body).sort()).to.eql([\"type\", \"title\", \"status\", \"detail\", \"instance\", \"code\", \"traceId\"].sort());",
              "  pm.expect(body.code).to.eql(\"ZONE_NOT_IN_TEMPLATE\");",
              "});"
            ]
          }
        }
      ]
    },
