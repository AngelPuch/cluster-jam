{
  "info": {
    "name": "Cluster JAM - Design Rules Analysis",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "21 solicitudes en orden. Reutiliza printId y JWT de admin/cliente. Crea solo una plantilla QA inactiva; el análisis no crea diseños ni cotizaciones, no activa Catalog y conserva minimumDpi=null hasta la decisión del equipo. Usa archivos originales ya cargados, sin adjuntos nuevos."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminAccessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Leer versión e imagen de referencia",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/admin/prints/{{printId}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const version = pm.response.json().latestVersion;",
              "  pm.environment.set(\"analysisPrintVersionId\", version.id);",
              "  pm.environment.set(\"analysisFileId\", version.fileId);",
              "  pm.environment.set(\"analysisPrintSurchargeCents\", version.surchargeCents);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Crear plantilla QA inactiva",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/template-versions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{$guid}}\",\n  \"sizeId\": 1,\n  \"expectedVersion\": 0,\n  \"front\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"back\": {\n    \"widthMm\": \"400\",\n    \"heightMm\": \"600\"\n  },\n  \"zones\": [\n    {\n      \"code\": \"chest\",\n      \"side\": \"FRONT\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        }\n      ]\n    },\n    {\n      \"code\": \"upper-back\",\n      \"side\": \"BACK\",\n      \"xMm\": \"50\",\n      \"yMm\": \"50\",\n      \"widthMm\": \"200\",\n      \"heightMm\": \"300\",\n      \"sizes\": [\n        {\n          \"label\": \"SMALL\",\n          \"widthMm\": \"100\",\n          \"heightMm\": \"150\",\n          \"surchargeCents\": 1250\n        }\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const value = pm.response.json();",
              "  const front = value.zones.find(zone => zone.side === \"FRONT\");",
              "  const back = value.zones.find(zone => zone.side === \"BACK\");",
              "  pm.environment.set(\"analysisTemplateId\", value.id);",
              "  pm.environment.set(\"analysisTemplateSnapshot\", JSON.stringify(value));",
              "  pm.environment.set(\"analysisFrontZoneId\", front.id);",
              "  pm.environment.set(\"analysisFrontSizeId\", front.sizes[0].id);",
              "  pm.environment.set(\"analysisBackZoneId\", back.id);",
              "  pm.environment.set(\"analysisBackSizeId\", back.sizes[0].id);",
              "  pm.test(\"Borrador\", () => pm.expect(value.active).to.eql(false));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Analizar frente catálogo y espalda archivo propio",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/v1/admin/template-versions/{{analysisTemplateId}}/design-analyses",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applications\": [\n    {\n      \"zoneId\": \"{{analysisFrontZoneId}}\",\n      \"zoneSizeId\": \"{{analysisFrontSizeId}}\",\n      \"printVersionId\": \"{{analysisPrintVersionId}}\"\n    },\n    {\n      \"zoneId\": \"{{analysisBackZoneId}}\",\n      \"zoneSizeId\": \"{{analysisBackSizeId}}\",\n      \"fileId\": \"{{analysisFileId}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) {",
              "  const value = pm.response.json();",
              "  pm.environment.set(\"analysisSnapshot\", JSON.stringify(value));",
              "  pm.test(\"Solo diagnóstico sin umbral inventado\", () => {",
              "    pm.expect(value.diagnosticOnly).to.eql(true);",
              "    pm.expect(value.catalogCompatibilityVerified).to.eql(false);",
              "    pm.expect(value.templateActive).to.eql(false);",
              "    pm.expect(value.minimumDpi).to.eql(null);",
              "    pm.expect(value.currency).to.eql(\"MXN\");",
              "    pm.expect(value.personalizationSurchargeCents).to.eql(2500 + Number(pm.environment.get(\"analysisPrintSurchargeCents\")));",
              "    pm.expect(value.applications.length).to.eql(2);",
              "    for (const application of value.applications) {",
              "      pm.expect(application.resolutionStatus).to.eql(\"THRESHOLD_NOT_CONFIGURED\");",
              "      pm.expect(Number(application.effectiveDpi)).to.be.above(0);",
              "      pm.expect(Number(application.placement.widthMm)).to.be.at.most(100.000001);",
              "      pm.expect(Number(application.placement.heightMm)).to.be.at.most(150.000001);",
              "    }",
              "    pm.expect(value.applications[1].printSurchargeCents).to.eql(0);",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
