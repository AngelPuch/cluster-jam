APP_ENV=development
HTTP_ADDRESS=127.0.0.1
HTTP_PORT=8083
CATALOG_DOCS_ENABLED=true

CATALOG_DB_URL=jdbc:postgresql://127.0.0.1:5436/catalogo_db
CATALOG_DB_USER=app_catalogo
CATALOG_DB_PASSWORD=
CATALOG_MIGRATION_PASSWORD=
CATALOG_POSTGRES_ADMIN_PASSWORD=

SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE_JWT_ISSUER=https://service-issuer.example

CATALOG_PHOTOS_BUCKET=catalog-photos
CATALOG_STORAGE_KEY=
CATALOG_PHOTO_CLEANUP_DELAY_MS=60000

LOG_LEVEL=INFO
# SERVICE_VERSION=0.1.0-SNAPSHOT
# INSTANCE_ID=catalog-local-1
CATALOG_WRITES_PER_MINUTE=30
CATALOG_MAX_JSON_BYTES=65536
CATALOG_CURSOR_KEY=

# Local saga consumer. Enable after V8 and RabbitMQ provisioning.
CATALOG_MESSAGING_ENABLED=false
CATALOG_RABBITMQ_HOST=127.0.0.1
CATALOG_RABBITMQ_PORT=5672
CATALOG_RABBITMQ_VHOST=clusterjam
CATALOG_RABBITMQ_USER=catalog-consumer
CATALOG_RABBITMQ_PASSWORD=
CATALOG_RABBITMQ_TLS=false
# Test flags are set only while running the integration checks.
# CATALOG_VERIFY_RABBITMQ=true
# CATALOG_TEST_ORDERS_PASSWORD=

# Reservation expiration worker: every 30 seconds, at most 10 transactions per pass.
CATALOG_RESERVATION_EXPIRATION_ENABLED=true

# Enable after V10, confirms/returns configuration and RabbitMQ provisioning.
CATALOG_OUTBOX_PUBLISHER_ENABLED=false
# Local integration observer account, never needed by the application.
# CATALOG_TEST_OUTBOX_PASSWORD=
