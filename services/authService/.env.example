APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=INFO
SERVICE_VERSION=0.0.1
# INSTANCE_ID=auth-local-1

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_DATABASE_URL=postgresql://auth_outbox_runtime:change_me@127.0.0.1:54322/postgres
# false is for the disposable local Supabase stack only. Use true in hosted environments.
OUTBOX_DATABASE_SSL=false
# OUTBOX_DATABASE_CA_PATH=/absolute/path/to/supabase-ca.crt
RABBITMQ_URL=amqp://auth-publisher:local-publisher-only@127.0.0.1:5672/clusterjam
