APP_ENV=development
HTTP_PORT=8085
LOG_LEVEL=INFO

DB_HOST=127.0.0.1
DB_PORT=5437
DB_NAME=payments_db
DB_USER=app_pagos
DB_PASSWORD=change_me
DB_SSL=false
# DB_CA_PATH=/run/config/payments-db-ca.crt

# Optional until payment processing is connected. Use a private test key only.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY
# Separate signing secret of the Stripe webhook destination.
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_SIGNING_SECRET

RABBITMQ_ENABLED=false
# Provision the local broker first. Missing Stripe key keeps commands queued.
# RABBITMQ_URI=amqp://payments-consumer:YOUR_ENCODED_PASSWORD@127.0.0.1:5672/clusterjam
# RABBITMQ_CA_PATH=/run/config/rabbitmq-ca.crt

# Used only to initialize the local development database.
PAYMENTS_POSTGRES_ADMIN_PASSWORD=change_me_admin
PAYMENTS_MIGRATION_PASSWORD=change_me_migration
