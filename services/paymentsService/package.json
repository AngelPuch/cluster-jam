{
    "name": "payments-service",
    "version": "0.0.1",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "migration:run": "npm run build && node dist/commands/migrate.js",
        "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
        "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
        "format:check": "prettier --check \"{src,test}/**/*.ts\"",
        "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
    },
    "dependencies": {
        "@nestjs/common": "12.0.3",
        "@nestjs/config": "12.0.0",
        "@nestjs/core": "12.0.3",
        "@nestjs/platform-express": "12.0.3",
        "@nestjs/swagger": "12.0.2",
        "@opentelemetry/api": "1.10.0",
        "@opentelemetry/context-async-hooks": "3.0.0",
        "@opentelemetry/core": "3.0.0",
        "@opentelemetry/sdk-trace": "3.0.0",
        "amqplib": "0.10.9",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "helmet": "8.3.0",
        "pg": "8.23.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "stripe": "23.2.0",
        "typeorm": "1.1.1"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@nestjs/cli": "11.0.24",
        "@nestjs/testing": "12.0.3",
        "@types/amqplib": "0.10.8",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/node": "24.13.5",
        "@types/supertest": "7.2.1",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.12.0",
        "jest": "30.5.1",
        "prettier": "3.9.7",
        "supertest": "7.2.2",
        "ts-jest": "29.4.12",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0"
    },
    "jest": {
        "rootDir": ".",
        "testEnvironment": "node",
        "testRegex": "test/.*\\.spec\\.ts$",
        "extensionsToTreatAsEsm": [
            ".ts"
        ],
        "moduleNameMapper": {
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "transform": {
            "^.+\\.ts$": [
                "ts-jest",
                {
                    "useESM": true,
                    "tsconfig": "test/tsconfig.json"
                }
            ]
        }
    }
}
