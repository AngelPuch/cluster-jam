APP_ENV=development
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
GRPC_PORT=50051
LOG_LEVEL=INFO
DB_HOST=db-personalizacion
DB_PORT=5432
DB_NAME=personalizacion_db
DB_USER=app_personalizacion
DB_SCHEMA=app
DB_CONNECT_TIMEOUT_SECONDS=5
# Inside Docker, Compose supplies this secret file.
DB_PASSWORD_FILE=/run/secrets/personalization_db_password

SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
