{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "..",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".ts"],
    "moduleNameMapper": { "^(\\.{1,2}/.*)\\.js$": "$1" },
    "testRegex": "test/.*\\.integration-spec\\.ts$",
    "testTimeout": 30000,
    "transform": {
        "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": "test/tsconfig.spec.json" }]
    }
}
