HTTP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cluster_jam_accounts
DB_USER=accounts
DB_PASSWORD=change_me
DB_SSL=false
# DB_CA_PATH=/run/config/postgres-ca.crt

LOG_LEVEL=INFO
RABBITMQ_CONSUMER_ENABLED=true
RABBITMQ_URI=amqp://profile-consumer:local-profile-only@localhost:5672/clusterjam
# Staging/production require amqps and verified TLS.
# RABBITMQ_CA_PATH=/run/config/cluster-ca.crt
RABBITMQ_EXCHANGE=identity.events
RABBITMQ_QUEUE=profile.identity.user-registered.v1
RABBITMQ_RETRY_EXCHANGE=profile.identity.user-registered.retry
RABBITMQ_RETRY_QUEUE_1=profile.identity.user-registered.retry.1
RABBITMQ_RETRY_QUEUE_2=profile.identity.user-registered.retry.2
RABBITMQ_RETRY_DELAY_1_MS=5000
RABBITMQ_RETRY_DELAY_2_MS=30000
RABBITMQ_DLX=profile.identity.user-registered.dead-letter
RABBITMQ_DLQ=profile.identity.user-registered.dlq
RABBITMQ_MAX_ATTEMPTS=3
