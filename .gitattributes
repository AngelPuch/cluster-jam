# Automatically normalize text files
* text=auto

# Unix scripts must use LF
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Personalization source and Linux container inputs
services/personalizationService/** text eol=lf
infra/personalization/** text eol=lf
.github/workflows/personalization-ci.yml text eol=lf
contracts/openapi/personalization/** text eol=lf
contracts/postman/personalization/** text eol=lf

/Vagrantfile text eol=lf
/script-provision.sh text eol=lf
